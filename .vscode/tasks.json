{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/WeatherDashboard.Web/WeatherDashboard.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/WeatherDashboard.Web/WeatherDashboard.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/WeatherDashboard.Web/WeatherDashboard.Web.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "test with coverage",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}",
        "--collect:XPlat Code Coverage"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test: Application.UnitTests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/tests/WeatherDashboard.Application.UnitTests"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test: Domain.UnitTests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/tests/WeatherDashboard.Domain.UnitTests"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test: Infrastructure.UnitTests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/tests/WeatherDashboard.Infrastructure.UnitTests"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test: Infrastructure.IntegrationTests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/tests/WeatherDashboard.Infrastructure.IntegrationTests"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test: Web.UnitTests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/tests/WeatherDashboard.Web.UnitTests"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test: Web.UiTests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/tests/WeatherDashboard.Web.UiTests"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
