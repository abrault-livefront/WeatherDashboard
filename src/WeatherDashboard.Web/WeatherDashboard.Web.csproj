<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ScopedCssEnabled>false</ScopedCssEnabled>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fluxor.Blazor.Web"/>
    <PackageReference Include="Fluxor.Blazor.Web.ReduxDevTools"/>
    <PackageReference Include="JetBrains.Annotations"/>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="NeoSmart.Caching.Sqlite.AspNetCore"/>
    <PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" />
    <PackageReference Include="Radzen.Blazor"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.AspNetCore"/>
    <PackageReference Include="Serilog.Enrichers.CorrelationId"/>
    <PackageReference Include="Serilog.Enrichers.Environment"/>
    <PackageReference Include="Serilog.Enrichers.Process"/>
    <PackageReference Include="Serilog.Enrichers.Thread"/>
    <PackageReference Include="Serilog.Sinks.OpenTelemetry"/>
    <PackageReference Include="TimeZoneNames"/>
    <PackageReference Include="UnitsNet" />
    <PackageReference Include="ZiggyCreatures.FusionCache"/>
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.NeueccMessagePack"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Components"/>
    <Using Include="Microsoft.AspNetCore.Components.Web"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeatherDashboard.Application\WeatherDashboard.Application.csproj"/>
    <ProjectReference Include="..\WeatherDashboard.Infrastructure\WeatherDashboard.Infrastructure.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localizations\Features\Weather\Components\WeeklyForecastCard.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>WeeklyForecastCard.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizations\SharedResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SharedResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizations\Features\Weather\Home.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Home.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizations\Features\Weather\Components\CurrentHighlightsCard.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CurrentHighlightsCard.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizations\Features\Weather\Components\LocationSearchField.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>LocationSearchField.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="Localizations\Features\Weather\Components\WeeklyForecastCard.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>WeeklyForecastCard.resx</DependentUpon>
    </Compile>
    <Compile Update="Localizations\SharedResource.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>SharedResource.resx</DependentUpon>
    </Compile>
    <Compile Update="Localizations\Features\Weather\Home.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>Home.resx</DependentUpon>
    </Compile>
    <Compile Update="Localizations\Features\Weather\Components\CurrentHighlightsCard.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CurrentHighlightsCard.resx</DependentUpon>
    </Compile>
    <Compile Update="Localizations\Features\Weather\Components\LocationSearchField.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>LocationSearchField.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="WeatherDashboard.Web.DataProtection.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="wwwroot\fonts\" />
  </ItemGroup>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).UiTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
